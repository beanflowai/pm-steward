# PM instance configuration.
#
# Copy to one of:
#   - config/pm.env                 (repo-local, gitignored)
#   - ~/.config/pm/pm.env           (per-user install)
# and replace every value with one for your machine.
#
# Precedence: $PM_CONFIG > ~/.config/pm/pm.env > <repo>/config/pm.env
# Keep exactly one copy per instance.
#
# This file must not contain secrets if it is committed. Credentials for the
# completion channel live in a 600 netrc file referenced by PM_NOTIFY_NETRC.

# --- worker -----------------------------------------------------------------
PM_WORKER_SSH_TARGET=worker
# PATH prefix for a non-interactive shell, if the runner is not on the default
# PATH (version-manager installs usually are not). Empty means no prefix.
PM_WORKER_PATH=
PM_WORKER_SPOOL_DIR=/var/tmp/pm-spool
PM_WORKER_LOG_DIR=/var/tmp/pm-logs
PM_WORKER_WRAPPER_DIR=/var/tmp/pm-wrappers

# --- runner -----------------------------------------------------------------
# Rendered into the worker wrapper as a shell array: one argument per word.
# Quote the whole value, because this file is sourced by bash.
# No command substitution and no shell operators.
PM_RUNNER_CMD='ccs default-profile --print --output-format json --max-turns 80 --dangerously-skip-permissions'

# --- PM-side state ----------------------------------------------------------
PM_STATE_DIR=$HOME/.local/state/pm
PM_REGISTRY_DIR=$PM_STATE_DIR/registry
PM_TASK_DIR=$PM_STATE_DIR/tasks
# Receipts written by the PM when a wake arrives: one JSON object per line with
# task_id, received_at, kind, source. The sweep only reads this file.
PM_RECEIPTS=$PM_STATE_DIR/handoff-received.jsonl
# Sent ledger written by the hook. Defaults to the same path pattern.
# PM_SENT_LEDGER=$PM_STATE_DIR/handoff-sent.jsonl

# --- host hook runtime (adapter) --------------------------------------------
# Used by host-side hook scripts, not by bin/. The shim contract is in
# adapters/muse.md; the polling loop itself is host-specific and not shipped.
# PM_HOOK_RUNTIME=$HOME/hooks/scripts/muse-runtime.sh
# Executable run by dispatch before launch to create and verify the hook (R27).
# PM_HOOK_CREATE_CMD=$HOME/hooks/scripts/create-hook.sh

# --- wrapper template -------------------------------------------------------
# Defaults to bin/worker-wrapper.sh.template next to the scripts.
# PM_TEMPLATE_PATH=/absolute/path/to/worker-wrapper.sh.template

# --- completion channel -----------------------------------------------------
PM_NOTIFY_URL=https://ntfy.example.com
PM_NOTIFY_TOPIC=replace-with-an-unguessable-topic
PM_NOTIFY_NETRC=$HOME/.config/pm/ntfy/netrc

# --- monitoring -------------------------------------------------------------
# Both log size and worktree fingerprint must be unchanged before a reminder.
PM_MONITOR_INTERVAL_SECS=600
PM_MONITOR_TICK_SECS=10

# --- model routing (optional) -----------------------------------------------
# Read by the PM agent at dispatch time (R28), not by the scripts in bin/.
# PM_MODEL_ROUTING_URL=https://sheets.googleapis.com/v4/spreadsheets/<sheet_id>/values/A1:L1000
# PM_MODEL_ROUTING_KEY=<read-only-key>

# --- sweep ------------------------------------------------------------------
PM_SWEEP_STALE_SECS=2100
PM_SWEEP_START_GRACE_SECS=300
# A done record older than this without a receipt is reported as a lost wake.
PM_SWEEP_LOST_AFTER_SECS=3600

# --- read-only status query -------------------------------------------------
PM_STATUS_WINDOW_DAYS=7
PM_STATUS_DONE_OVERDUE_SECS=3600
PM_STATUS_DONE_LOST_SECS=7200
PM_STATUS_STALE_SECS=7200
PM_STATUS_TRUSTED_SOURCES=pm,PM,watchdog

# --- smoke test -------------------------------------------------------------
# Comma-separated identifiers that must never appear in the public repo
# (your hostnames, usernames, company names). Optional but recommended.
# PM_SMOKE_DENY=your-hostname,your-company

# --- ssh --------------------------------------------------------------------
# Extra options, e.g. a tunnel proxy. Keep binary paths absolute.
# Quote any value that contains spaces.
# PM_SSH_OPTS='-o ProxyCommand=/usr/local/bin/cloudflared access ssh --hostname %h'
